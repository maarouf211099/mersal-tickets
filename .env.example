# ============================================================
# إعدادات نظام التذاكر — انسخ الملف ده باسم .env
# على السيرفر: بيتحط في فولدر النشر (DEPLOY_DIR/.env) مرة واحدة
# ============================================================

# داتابيز خاصة بالنظام (CREATE DATABASE mersal_tickets;)
# ?schema=tickets إجباري — الجداول كلها بتتعمل جوه schema لوحدها فمش ممكن تلمس جداول أي سيستم تاني
# ⚠ لو كلمة السر فيها رموز زي @ : / # ? لازم تتكتب encoded: @ = %40  # = %23  : = %3A  / = %2F  ? = %3F
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mersal_tickets?schema=tickets"

# سر تشفير الجلسات — 32 حرف عشوائي على الأقل
# اعمله بالأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# البورت — لازم يكون مختلف عن بورتات السيستمز التانية
PORT=3005

# مكان حفظ المرفقات (برّه فولدر الكود). لو فاضي: DEPLOY_DIR/uploads
UPLOAD_DIR=""

# true لو النظام شغال ورا HTTPS
COOKIE_SECURE=false

# حساب المدير الأول (بيتعمل أول تشغيل بس لو مفيش ولا مستخدم)
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD=""
DEFAULT_ADMIN_NAME="مدير النظام"
