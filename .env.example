# ============================================================
# إعدادات نظام التذاكر — انسخ هذا الملف باسم .env
# على السيرفر يوضع في مجلد النشر (DEPLOY_DIR/.env) مرة واحدة
# ============================================================

# قاعدة بيانات خاصة بالنظام (CREATE DATABASE mersal_tickets;)
# المقطع ?schema=tickets إلزامي: تُنشأ الجداول كلها داخل مخطط مستقل فلا تمس جداول أي نظام آخر
# ⚠ إذا تضمنت كلمة المرور رموزًا مثل @ : / # ? فيجب ترميزها: @ = %40  # = %23  : = %3A  / = %2F  ? = %3F
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mersal_tickets?schema=tickets"

# مفتاح تشفير الجلسات — 32 حرفًا عشوائيًا على الأقل
# لتوليده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# المنفذ — يجب أن يختلف عن منافذ الأنظمة الأخرى
PORT=3005

# مكان حفظ المرفقات (خارج مجلد الكود). إذا تُرك فارغًا: DEPLOY_DIR/uploads
UPLOAD_DIR=""

# اجعلها true إذا كان النظام يعمل خلف HTTPS
COOKIE_SECURE=false

# حساب المدير الأول (يُنشأ عند أول تشغيل فقط إذا لم يوجد أي مستخدم)
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD=""
DEFAULT_ADMIN_NAME="مدير النظام"

# ============================================================
# الدخول من بوابة مرسال (اختياري)
# نفس قيمة SSO_SECRET_TICKETS في .env بتاع البوابة
# لو سبته فاضي: الدخول من البوابة متقفل والنظام شغال عادي
# ============================================================
PORTAL_SSO_SECRET=""

# ربط نظام إسعاف مرسال (زرار «🚑 طلب إسعاف» لفريق خط طوارئ مرسال)
# اعمل يوزر في نظام الإسعاف بدور «منسق» (dispatcher) وحط بياناته هنا. لو فاضيين الزرار بيظهر بس الإرسال مش هيشتغل.
AMBULANCE_URL="https://ambulance.mersal-ngo.info"
AMBULANCE_USERNAME=""
AMBULANCE_PASSWORD=""
